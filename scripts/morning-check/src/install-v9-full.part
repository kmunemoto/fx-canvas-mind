-- #397 (docs §8.150, §8.151): the morning check of the MACD ride's e-mails (scripts/morning-check, v9) as two read-only functions. ONE BLOCK, NO PIECES.
--
-- The same functions as supabase/migrations/{{MIGRATION}}, for the Supabase SQL Editor when the pieces (install-v9.sql) cannot be sent
-- (2026-11-13: the Supabase connector answered 502 for some time). The two sources are in this file in full (the repository's scripts/morning-check/pairs-v9.fn.sql
-- and gold-v9.fn.sql, byte for byte). Before anything is created, the block checks each text's md5 and length against the files' (a text cut short or changed
-- on the way, by a copy or a paste, stops it); after, it checks md5(prosrc) of what was created. Any difference raises an exception and nothing is kept:
-- the functions that were there before stay as they were.
--
-- Read only: language sql, stable, one WITH ... SELECT each. The schema mc is not one the API serves; anon and authenticated have no right on it or on the functions.
-- To take them away again: drop schema mc cascade;
-- THIS FILE IS GENERATED (scripts/morning-check/src/build.sh, mkinstall.py): do not edit it by hand. The two long texts end at the lines "$src$;".
create schema if not exists mc;
revoke all on schema mc from public, anon, authenticated;
do $do$
declare
  v_head constant text := '(p_start bigint, p_end bigint) returns table (row_type text, instrument text, bar_open_utc text, side text, verdict text, data json) language sql stable set search_path = '''' as ';
  v_pairs constant text := $src${{PAIRS_SRC}}$src$;
  v_gold constant text := $src${{GOLD_SRC}}$src$;
begin
  if md5(v_pairs) is distinct from '{{PAIRS_MD5}}' or length(v_pairs) is distinct from {{PAIRS_CHARS}} then
    raise exception 'the pairs source differs from the repository: md5 %, % chars', md5(v_pairs), length(v_pairs);
  end if;
  if md5(v_gold) is distinct from '{{GOLD_MD5}}' or length(v_gold) is distinct from {{GOLD_CHARS}} then
    raise exception 'the gold source differs from the repository: md5 %, % chars', md5(v_gold), length(v_gold);
  end if;
  if position('$mc$' in v_pairs) > 0 or position('$mc$' in v_gold) > 0 then
    raise exception 'a source holds the dollar quote';
  end if;
  execute 'create or replace function mc.pairs_v9' || v_head || '$mc$' || v_pairs || '$mc$';
  execute 'revoke all on function mc.pairs_v9(bigint, bigint) from public, anon, authenticated';
  execute 'create or replace function mc.gold_v9' || v_head || '$mc$' || v_gold || '$mc$';
  execute 'revoke all on function mc.gold_v9(bigint, bigint) from public, anon, authenticated';
  if (select md5(p.prosrc) from pg_catalog.pg_proc p where p.oid = to_regprocedure('mc.pairs_v9(bigint,bigint)')) is distinct from '{{PAIRS_MD5}}' then
    raise exception 'mc.pairs_v9: the stored source differs from the repository';
  end if;
  if (select md5(p.prosrc) from pg_catalog.pg_proc p where p.oid = to_regprocedure('mc.gold_v9(bigint,bigint)')) is distinct from '{{GOLD_MD5}}' then
    raise exception 'mc.gold_v9: the stored source differs from the repository';
  end if;
  drop table if exists mc._src;
end
$do$;
select 'installed' as done, p.proname as function, md5(p.prosrc) as md5, length(p.prosrc) as chars
from pg_catalog.pg_proc p join pg_catalog.pg_namespace n on n.oid = p.pronamespace where n.nspname = 'mc' order by 2;
