  union all
  -- the run itself (last in this list, so that elapsed_s is read after everything else was done; shown first)
  select 0, 0, 0, 'RUN', null, null, null, 'info',
         json_build_object('sql', '{{SQLNAME}} v9', 'rule', 'macdx_12_26_9_w600_1h_ride90to96of120_{in,at,out}_v9', 'keys', pp.k_first || '..' || pp.k_last,
           'range_utc', to_char(to_timestamp(pp.start_ms / 1000.0) at time zone 'UTC', 'YYYY-MM-DD HH24:MI') || ' .. ' || to_char(to_timestamp(pp.end_ms / 1000.0) at time zone 'UTC', 'YYYY-MM-DD HH24:MI'),
           'range_is_one_gmo_day', pp.range_ok, 'db_now_utc', to_char(now() at time zone 'UTC', 'YYYY-MM-DD HH24:MI:SS'),
           'go_live_utc', (select to_char(to_timestamp(min(live_ms) / 1000.0) at time zone 'UTC', 'YYYY-MM-DD HH24:MI') from syms),
           'lines', (select count(*) from cv) + (select count(*) from ov), 'elapsed_s', round(extract(epoch from clock_timestamp() - statement_timestamp())::numeric, 2),
           -- the function form: the md5 and length of the function's own source AS THE DATABASE HOLDS IT (pg_proc.prosrc). The caller compares it with the md5 of the repository's
           -- {{FNFILE}} (the same text): a mismatch means the function in the database is not the repository's (apply the migration again; the numbers of this answer are then
           -- not to be trusted)
           'via', 'function {{FN}}',
           'sql_md5', (select md5(q.prosrc) from pg_catalog.pg_proc q where q.oid = '{{FN}}(bigint,bigint)'::regprocedure),
           'sql_chars', (select length(q.prosrc) from pg_catalog.pg_proc q where q.oid = '{{FN}}(bigint,bigint)'::regprocedure))
  from pp
)
select row_type, instrument, bar_open_utc, side, verdict, data from u order by o1, o2, o3
