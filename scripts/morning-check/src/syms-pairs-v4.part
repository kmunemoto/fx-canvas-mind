-- ===== FRONT (five pairs): public.gmo_kline_files -> us(symbol, ot, seq, m8, d), the series production judges on =====
-- instrument table: GMO symbol, the app's pair name, display order, the instant from which the v4 rule (signal-alerts v28) was live, and the decimals
-- of the chart's rounding (decimalsOf: 3 for a ...JPY pair, 5 for the others):
-- 1792011600000 = 2026-10-14 21:00 UTC (a GMO-day boundary), the first judged bar opened then (bars opened before it were judged by v27, the v3 rule with another rule id: no v4 mails possible).
syms as (
  select * from (values
    ('USD_JPY', 'USD/JPY', 1, 1792011600000::bigint, 3), ('EUR_JPY', 'EUR/JPY', 2, 1792011600000::bigint, 3), ('AUD_JPY', 'AUD/JPY', 3, 1792011600000::bigint, 3),
    ('EUR_USD', 'EUR/USD', 4, 1792011600000::bigint, 5), ('AUD_USD', 'AUD/USD', 5, 1792011600000::bigint, 5)
  ) v(symbol, pair, ord, live_ms, d)
),
