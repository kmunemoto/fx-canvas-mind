-- ===== FRONT (five pairs): public.gmo_kline_files -> us(symbol, ot, seq, m8, d), the series production judges on =====
-- instrument table: GMO symbol, the app's pair name, display order, the instant from which the v8 rule (signal-alerts v33, #386) was live, and the decimals
-- of the chart's rounding (decimalsOf: 3 for a ...JPY pair, 5 for the others):
-- 1793325600000 = 2026-10-30 02:00 UTC, the first 1-hour bar v33 judged (v33 went live at 02:51 UTC, in the middle of GMO day 20261030; bars opened before it were judged on the 15-minute chart by v31 / v32, rule v7: no v8 mails possible).
syms as (
  select * from (values
    ('USD_JPY', 'USD/JPY', 1, 1793325600000::bigint, 3), ('EUR_JPY', 'EUR/JPY', 2, 1793325600000::bigint, 3), ('AUD_JPY', 'AUD/JPY', 3, 1793325600000::bigint, 3),
    ('EUR_USD', 'EUR/USD', 4, 1793325600000::bigint, 5), ('AUD_USD', 'AUD/USD', 5, 1793325600000::bigint, 5)
  ) v(symbol, pair, ord, live_ms, d)
),
