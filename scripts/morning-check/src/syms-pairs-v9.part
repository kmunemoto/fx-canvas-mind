-- ===== FRONT (five pairs): public.gmo_kline_files -> us(symbol, ot, seq, m8, d, h8, l8, bc, ac), the series production judges on =====
-- instrument table: GMO symbol, the app's pair name, display order, the instant from which the v9 rule (signal-alerts v39, #397, the MACD ride) was live, and the decimals
-- of the chart's rounding (decimalsOf: 3 for a ...JPY pair, 5 for the others):
-- 1794466800000 = 2026-11-12 07:00 UTC, the first 1-hour bar v39 judged (v39 answered from the call of 07:34:00 UTC, in the middle of GMO day 20261112; bars opened before it were judged by v38, rule v8: no v9 mails and no rides possible).
syms as (
  select * from (values
    ('USD_JPY', 'USD/JPY', 1, 1794466800000::bigint, 3), ('EUR_JPY', 'EUR/JPY', 2, 1794466800000::bigint, 3), ('AUD_JPY', 'AUD/JPY', 3, 1794466800000::bigint, 3),
    ('EUR_USD', 'EUR/USD', 4, 1794466800000::bigint, 5), ('AUD_USD', 'AUD/USD', 5, 1794466800000::bigint, 5)
  ) v(symbol, pair, ord, live_ms, d)
),
